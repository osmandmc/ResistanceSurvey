@model ErrorViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hata · Direniş Takip</title>
    <style>
        body { margin: 0; font-family: 'IBM Plex Sans', system-ui, sans-serif; background: #f3f4f6; color: #111827; }
        main { max-width: 560px; margin: 80px auto; padding: 24px 28px; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; }
        h1 { margin: 0 0 12px; font-size: 24px; color: #b42318; }
        a { color: #0b5e5e; }
        code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; }
    </style>
</head>
<body>
    <main>
        <h1>Beklenmeyen bir hata oluştu.</h1>
        <p>İşlem tamamlanamadı. Sayfayı yenileyip tekrar deneyin; sorun sürerse aşağıdaki hata kodunu iletin.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Hata kodu:</strong> <code>@Model.RequestId</code></p>
        }
        <p><a href="/app/">Uygulamaya dön</a></p>
    </main>
</body>
</html>
