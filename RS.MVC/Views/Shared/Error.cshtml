@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Beklenmeyen bir hata oluştu.</h1>
<p>İşlem tamamlanamadı. Sayfayı yenileyip tekrar deneyin; sorun sürerse aşağıdaki hata kodunu iletin.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Hata kodu:</strong> <code>@Model.RequestId</code>
    </p>
}
